{
  "name": "galaticos",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "pb:install": "sh pocketbase/install.sh",
    "pb": "set -a; [ -f .env ] && . ./.env; set +a; pocketbase/pocketbase serve --http 127.0.0.1:8096 --dir pocketbase/pb_data --hooksDir pocketbase/pb_hooks --migrationsDir pocketbase/pb_migrations --publicDir pocketbase/pb_public",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.sw.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "push": "node --env-file-if-exists=.env push/server.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "barcode-detector": "^3.2.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.63.0",
    "next-themes": "^0.4.6",
    "pocketbase": "^0.28.1",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "qrcode": "^1.5.4",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
