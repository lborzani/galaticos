{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "node", "vite-plugin-pwa/react"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "tests", "e2e", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["src/sw.ts"]
}
