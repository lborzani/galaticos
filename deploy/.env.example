# Copie para deploy/.env no servidor. Nunca versione o .env.
DOMAIN=galaticos.exemplo.com.br

# E-mail (verificação de conta e recuperação de senha). Lido na 1ª subida; depois ajuste no painel /_/.
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SENDER=nao-responda@exemplo.com.br

# Web Push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com.br
# string longa e aleatória: openssl rand -base64 32
PUSH_SECRET=

# Backups automáticos do PocketBase (cron e quantos manter). Lidos na 1ª subida.
BACKUP_CRON=0 4 * * *
BACKUP_KEEP=14
