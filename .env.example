# Copie para .env. `npm run pb` e `npm run push` leem este arquivo.

# Lidas pelo PocketBase na primeira migração; depois ajuste pelo painel /_/ > Settings.
APP_URL=http://localhost:5173
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SENDER=nao-responda@galaticos.local

# Web Push. Gere as chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@galaticos.local
# segredo compartilhado entre PocketBase e o sidecar (qualquer string longa e aleatória)
PUSH_SECRET=
PUSH_URL=http://127.0.0.1:8098
