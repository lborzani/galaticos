rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────────────────────────────
    // Helpers
    // ────────────────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Impede que campos protegidos sejam alterados pelo cliente
    function notChanging(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ────────────────────────────────────────────────────────────────────────
    // users/{userId}
    // ────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Qualquer usuário autenticado pode ler perfis (necessário para convites e
      // listagem de participantes)
      allow read: if isAuth();

      // Criação: apenas o próprio usuário pode criar seu perfil
      allow create: if isOwner(userId)
        && request.resource.data.role == 'member'; // role inicial sempre 'member'

      // Atualização: dono pode editar, admin pode alterar qualquer campo
      allow update: if isOwner(userId) && notChanging(['role', 'uid'])
        || isAdmin();

      // Exclusão apenas por admin
      allow delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────────
    // events/{eventId}
    // ────────────────────────────────────────────────────────────────────────
    match /events/{eventId} {
      // Qualquer usuário autenticado pode listar e ler eventos
      allow read: if isAuth();

      // Apenas admin pode criar, editar e excluir eventos
      allow create, update, delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────────
    // registrations/{registrationId}
    // ────────────────────────────────────────────────────────────────────────
    match /registrations/{registrationId} {
      // Qualquer autenticado pode ler (lista de participantes é pública no app)
      allow read: if isAuth();

      // Inscrição: o próprio usuário pode criar sua inscrição
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.status in ['confirmed', 'waitlist'];

      // Atualização:
      // - Dono pode cancelar sua inscrição (status → 'cancelled')
      // - Admin pode alterar qualquer campo (ex: marcar 'attended' via scanner)
      allow update: if
        (isOwner(resource.data.userId)
          && request.resource.data.status == 'cancelled'
          && notChanging(['userId', 'eventId', 'position', 'waitlistPosition']))
        || isAdmin();

      // Registros nunca são deletados — usamos status 'cancelled'
      allow delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────────
    // primeTeams/{teamId}
    // ────────────────────────────────────────────────────────────────────────
    match /primeTeams/{teamId} {
      allow read: if isAuth();

      // Capitão cria o time (captainId deve ser o próprio usuário)
      allow create: if isOwner(request.resource.data.captainId);

      // Apenas o capitão ou admin pode atualizar o time
      allow update: if isOwner(resource.data.captainId) || isAdmin();

      allow delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────────
    // invites/{inviteId}
    // ────────────────────────────────────────────────────────────────────────
    match /invites/{inviteId} {
      // Capitão (remetente) e convidado (destinatário) podem ler o convite
      allow read: if isAuth() &&
        (request.auth.uid == resource.data.captainId ||
         request.auth.uid == resource.data.toUserId);

      // Apenas o capitão pode criar um convite
      allow create: if isOwner(request.resource.data.captainId)
        && request.resource.data.status == 'pending';

      // Convidado pode aceitar/recusar; admin pode fazer qualquer alteração
      allow update: if
        (isOwner(resource.data.toUserId)
          && request.resource.data.status in ['accepted', 'declined']
          && notChanging(['eventId', 'captainId', 'toUserId']))
        || isAdmin();

      allow delete: if isAdmin();
    }

  }
}
